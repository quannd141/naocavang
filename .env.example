# Copy to .env.local for local dev

# Mode
NODE_ENV=development

# Database
DATABASE_URL=postgresql://nao_ca_vang:dev_password@localhost:5432/nao_ca_vang_dev?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
NEXTAUTH_SECRET=generate_via_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI — https://ai.google.dev/ (Gemini Flash free tier) and https://console.anthropic.com/
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Cloudflare R2 — https://dash.cloudflare.com/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nao-ca-vang-dev

# Email Resend — https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=hello@naocavang.com

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Frontend public env
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_URL=http://localhost:3000

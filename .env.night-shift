# 🌙 NIGHT-SHIFT ENV — Mock mode only
# All real credentials are FAKE_KEY_DO_NOT_USE — agent must use mock adapters

NIGHT_SHIFT_MODE=true
NODE_ENV=development

# Database (local only, postgres in docker-compose)
DATABASE_URL=postgresql://nao_ca_vang:dev_password@localhost:5432/nao_ca_vang_dev?schema=public

# Redis (local)
REDIS_URL=redis://localhost:6379

# Auth
NEXTAUTH_SECRET=dev_only_secret_32chars_minimum_xxxxx
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (FAKE — Quân setup thật khi launch)
GOOGLE_CLIENT_ID=FAKE_KEY_DO_NOT_USE
GOOGLE_CLIENT_SECRET=FAKE_KEY_DO_NOT_USE

# AI Providers — FAKE in night-shift, MockAIProvider sẽ được dùng
GEMINI_API_KEY=FAKE_KEY_DO_NOT_USE
ANTHROPIC_API_KEY=FAKE_KEY_DO_NOT_USE

# Cloudflare R2 — FAKE
R2_ACCOUNT_ID=FAKE_KEY_DO_NOT_USE
R2_ACCESS_KEY_ID=FAKE_KEY_DO_NOT_USE
R2_SECRET_ACCESS_KEY=FAKE_KEY_DO_NOT_USE
R2_BUCKET=nao-ca-vang-dev

# Email — Resend FAKE, log to file
RESEND_API_KEY=FAKE_KEY_DO_NOT_USE
EMAIL_FROM=hello@naocavang.local

# Sentry — disabled in night-shift
SENTRY_DSN=
SENTRY_ENVIRONMENT=night-shift

# Frontend public env
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
